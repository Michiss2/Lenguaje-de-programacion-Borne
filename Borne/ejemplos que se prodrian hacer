borne cls "Sistema de Inventario Vivero v1.0" {
    echo ===========================================
    echo    SISTEMA DE CONTROL Y GESTION BORNE
    echo ===========================================
    
    # Declaración de variables estilo Python (sin % ni set confuso)
    planta = "Suculenta Rara"
    stock_actual = 8
    stock_minimo = 15
    precio_unidad = 12
    
    echo Verificando inventario para: planta
    echo Cantidad actual: stock_actual
    
    # Estructura de control estilo C con llaves {}
    if (stock_actual < stock_minimo) {
        echo [ALERTA] El stock esta por debajo del minimo requerido.
        echo Calculando unidades a reproducir...
        
        faltantes = stock_minimo - stock_actual
        echo Unidades faltantes: faltantes
        
        # Bucle estilo C para simular reproducción/lote
        lote = 1
        while (lote <= faltantes) {
            echo Generando registro para planta numero: lote
            lote = lote + 1
        }
        
        echo Lote completado exitosamente.
    } else {
        echo [OK] El stock es suficiente para la venta.
    }
    
    # Cálculo de valor total del inventario
    valor_total = stock_actual * precio_unidad
    echo Valor estimado en inventario: valor_total USD
    
    echo ===========================================
    echo Ejecucion finalizada con exito en Borne.
}


